#include <stdio.h>
#include <string.h>
#include <ctype.h>

int contains_uppercase(const char *str) {
    for (int i = 0; str[i] != '\0'; i++) {
        if (isupper(str[i])) {
            return 1;
        }
    }
    return 0;
}

int contains_lowercase(const char *str) {
    for (int j = 0; str[j] != '\0'; j++) {
        if (islower(str[j])) {
            return 1;
        }
    }
    return 0;
}
int main(void)
{
    char pas[256];
    unsigned int len;
    int has_digit = 0;
    
    printf("Enter your password: ");
    fgets(pas, sizeof(pas), stdin);
    
    len = strlen(pas);
    for (int k=0; pas[k] != '\0'; k++) {
        if (isdigit((unsigned char)pas[k])) {
            has_digit = 1;
            break;
        }
    }
    
    
    if(len >= 8){ 
        if(contains_uppercase(pas)){ 
            if(contains_lowercase(pas)){ 
                if (has_digit) { 
                    printf("OK\n");
                } else {
                    printf("Prease include numbers\n");
                }
            }else{
                printf("Prease include capital letters\n");
            }
        }else{
            printf("Prease include lowercase letters\n");
        }
    }else{
        printf("Prease make it 8 characters of more\n");
    }
    
 
}
